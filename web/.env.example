CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Token with Cloudflare Pages edit permissions — used by deploy.sh
CLOUDFLARE_API_TOKEN=your_pages_token_here

# Token with Cloudflare Workers edit permissions — used for API deployment
CLOUDFLARE_WORKERS_API_TOKEN=your_workers_token_here

CLOUDFLARE_PROJECT_NAME=askamerica
